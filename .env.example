# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# Supabase -> Project Settings -> Database -> Connection string
# DATABASE_URL uses the pooled connection (port 6543) for the app at runtime.
# DIRECT_URL uses the direct connection (port 5432) for migrations and seeding.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Service role key: server-only. Signs the short-lived prescription links and lets the seed create
# the demo logins. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
